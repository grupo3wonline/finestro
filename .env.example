APP_NAME=Finestro
APP_ENV=local
APP_KEY=base64:gLKW1TOFHSN4OK/tNudR+yGuYwQknvBW8lKS6PVOIo4=
APP_DEBUG=true
APP_URL=http://finestro.test

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finestro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Seguranca do cookie de sessao.
# Em PRODUCAO (HTTPS) defina SESSION_SECURE_COOKIE=true para que o cookie
# so trafegue por HTTPS. Mantenha em local/dev como null (http).
SESSION_SECURE_COOKIE=null
# Bloqueia acesso ao cookie via JavaScript (mitiga roubo de sessao por XSS).
SESSION_HTTP_ONLY=true
# Politica SameSite: "lax" (padrao) mitiga CSRF; use "strict" para mais rigor.
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Shared hosting without a long-running worker: let `schedule:run` (cron,
# every minute) start `queue:work --stop-when-empty`. Keep false when a
# Supervisor/`composer dev` worker is running.
QUEUE_RUN_VIA_SCHEDULER=false

# Spatie Media Library: enqueue image conversions (thumbnails, responsive
# images) on the queue instead of processing them during the request.
# Set to false only in environments without a running queue worker.
QUEUE_CONVERSIONS_BY_DEFAULT=true

CACHE_STORE=database
# Lifetime (seconds) of the per-user cached dashboard/report summaries.
CACHE_USER_TTL=300

# Account activity log (spatie/laravel-activitylog). Entries older than this
# number of days are removed by the daily `activitylog:clean` schedule.
ACTIVITYLOG_RETENTION_DAYS=365

# REST API v1 (Laravel Sanctum personal tokens).
# Token lifetime in minutes (129600 = 90 days). Expired tokens are pruned daily.
SANCTUM_TOKEN_EXPIRATION=129600
# Requests per minute per user, shared by all of the user's tokens.
API_RATE_LIMIT_PER_MINUTE=60
# Requests per minute per client IP, applied before token authentication
# (also counts requests with missing or invalid tokens).
API_IP_RATE_LIMIT_PER_MINUTE=120
# Comma-separated origins allowed to call /api/* from a browser (CORS).
# Empty = only APP_URL.
CORS_ALLOWED_ORIGINS=

# Laravel Scout (transaction search). "database" runs LIKE queries on the app
# database, so no external search service is needed ("collection" also works).
SCOUT_DRIVER=database

# Swagger UI at /api/documentation (L5-Swagger). Keep false: the spec is built
# by `php artisan l5-swagger:generate` (run it on every deploy).
L5_SWAGGER_GENERATE_ALWAYS=false

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@finestro.com.br"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_TO_ADDRESS="contato@3wonline.com.br"

# Grupo 3W Online CTA (config/marketing.php). Must be the REAL number of new
# projects the business accepts per month, confirmed by the business (truthful
# copy, Brazilian CDC). Shown as "Atendemos no máximo N novos projetos por mês"
# only when set to a positive integer; unset, empty, 0 or invalid hides the line.
# MARKETING_CTA_MONTHLY_SLOTS=
# Social profile URLs shown in the footer. Empty = icon hidden.
MARKETING_SOCIAL_FACEBOOK=
MARKETING_SOCIAL_INSTAGRAM=
MARKETING_SOCIAL_LINKEDIN=

# Legal documents (config/legal.php). Bump LEGAL_POLICY_VERSION whenever the
# Terms of Use or Privacy Policy change: every user is asked to accept again.
LEGAL_POLICY_VERSION=2026-07
LEGAL_POLICY_UPDATED_AT=2026-07-01
# Data controller shown in the privacy policy (LGPD art. 9). Fill before
# go-live; while commented, a "[PREENCHER: ...]" placeholder is shown.
# LEGAL_CONTROLLER_NAME="Razão social Ltda"
# LEGAL_CONTROLLER_CNPJ="00.000.000/0001-00"
# LEGAL_CONTROLLER_ADDRESS="Rua Exemplo, 123 - Curitiba/PR"

# Privacy (config/privacy.php). E-mail of the data protection officer
# (encarregado/DPO) shown in the policy; defaults to contato@3wonline.com.br
# while commented (an empty value would blank it).
# PRIVACY_DPO_EMAIL=privacidade@example.com
# Hours a personal data export (Configurações > Privacidade) stays downloadable.
PRIVACY_EXPORT_TTL_HOURS=24

VITE_APP_NAME="${APP_NAME}"

# Stripe billing (see docs/billing/phase-2-stripe.md).
# Keys come from the Stripe Dashboard > Developers > API keys. Never commit
# real values; use test-mode keys outside production.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Signing secret of the /stripe/webhook endpoint (Dashboard or `stripe listen`).
STRIPE_WEBHOOK_SECRET=
# Monthly BRL price id printed by `php artisan stripe:setup`.
STRIPE_PROFESSIONAL_PRICE_ID=
# Displayed monthly price of the Profissional plan (must match the Stripe price).
STRIPE_PROFESSIONAL_PRICE=29.90

# Optional promotion. Active only when enabled, the promo price is > 0 and
# lower than STRIPE_PROFESSIONAL_PRICE, STRIPE_PROMO_ENDS_AT is in the future
# and STRIPE_PROMO_PRICE_ID points to a matching Stripe price.
STRIPE_PROMO_ENABLED=false
STRIPE_PROMO_PRICE=
# Promo end date/time in the app timezone, e.g. 2026-12-31 23:59:59
STRIPE_PROMO_ENDS_AT=
STRIPE_PROMO_PRICE_ID=
# Badge text shown during the promo (defaults to "Oferta especial").
STRIPE_PROMO_LABEL=

# Analytics / ads tags (config/services.php). Leave empty to disable. When set,
# they load only after the visitor opts in through the cookie banner
# (resources/js/consent.js, Google Consent Mode v2 defaults "denied").
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
FACEBOOK_PIXEL_ID=
