{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "3.1.2",
        "darkaonline/l5-swagger": "^11.2",
        "filament/filament": "^5.11",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.9",
        "laravel/tinker": "^3.0",
        "maatwebsite/excel": "^4.0",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.3",
        "stripe/stripe-php": "^20.1"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.33",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan optimize:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "lint": "pint --test",
        "format": "pint",
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "phpstan analyse --memory-limit=1G --no-progress"
        ],
        "refactor": "rector --dry-run",
        "quality": [
            "Composer\\Config::disableProcessTimeout",
            "@lint",
            "@analyse",
            "@refactor",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "scripts-descriptions": {
        "test": "Clear all framework caches (config, routes, views, Filament components) and run the test suite (Pest runner via php artisan test). Clearing avoids stale local caches polluting runs.",
        "lint": "Check code style with Laravel Pint without changing files.",
        "format": "Fix code style with Laravel Pint.",
        "analyse": "Run PHPStan (level 6 + Larastan) static analysis.",
        "refactor": "Run Rector in dry-run mode; fails if Rector would change any file.",
        "quality": "Run lint, analyse, refactor and test in sequence."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
